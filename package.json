{
  "name": "aistudio-tts-bot",
  "version": "1.0.0",
  "description": "Batch TTS automation CLI for Google AI Studio using Playwright-core and Chrome CDP",
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.0.0"
