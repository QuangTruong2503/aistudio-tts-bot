# Chrome DevTools Protocol endpoint
CDP_URL=http://127.0.0.1:9222

# Target URL match pattern
TARGET_URL_PATTERN=aistudio.google.com/generate-speech

# Wait & retry tuning (milliseconds)
MAX_WAIT_AUDIO_MS=600000
POLL_INTERVAL_MS=2000
MIN_DELAY_MS=5000
MAX_DELAY_MS=10000
MAX_RETRIES=2
RATE_LIMIT_COOLDOWN_MS=60000
STOP_ON_QUOTA_ERROR=false
ENABLE_NETWORK_INTERCEPT=false

# CMS Auto-Publish
PUBLISH_ENABLED=true
PUBLISH_URL=https://pnttaudio.netlify.app/admin/stories/59a33778-f5e0-4937-b3e8-b5ee46542872/chapters
MAX_WAIT_UPLOAD_MS=300000
